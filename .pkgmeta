# CurseForge packager metadata
# Repositório com 6 addons na raiz:
#   SpellFlashForever (core)
#   SpellFlash_Hunter / _Shaman / _Warrior / _Druid / _Paladin (módulos)
# Garante que o build empacote as 6 pastas soltas na raiz do ZIP
# (sem pasta-embrulho por cima).
package-as: SpellFlashForever
move-folders:
  SpellFlashForever: SpellFlashForever
  SpellFlash_Hunter: SpellFlash_Hunter
  SpellFlash_Shaman: SpellFlash_Shaman
  SpellFlash_Warrior: SpellFlash_Warrior
  SpellFlash_Druid: SpellFlash_Druid
  SpellFlash_Paladin: SpellFlash_Paladin
